# ============================================================
# Variables de Entorno — TiendaMiBarrio
# ============================================================
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
#
# Este es el ÚNICO archivo de entorno: sirve tanto para ejecutar
# la app localmente (npm run dev / node scripts/...) como para
# docker compose.
# ============================================================

# ---- MySQL ----
# Host del servidor MySQL:
#  - 'localhost' si la app corre en tu máquina (o MySQL local)
#  - 'db' si la app corre dentro de Docker Compose (docker-compose.yml lo sobreescribe)
DB_HOST=localhost

# Puerto MySQL al que se conecta la app:
#  - 3306 si tienes MySQL instalado localmente (valor por defecto del cliente)
#  - 3307 si la app corre localmente contra MySQL en Docker (ver DB_PORT_EXTERNAL)
#  - 3306 dentro de la red Docker (docker-compose.yml lo sobreescribe)
DB_PORT=3306

# Usuario de MySQL
DB_USER=root

# Contraseña del usuario root de MySQL
DB_PASSWORD=rootpassword

# Nombre de la base de datos
DB_NAME=tienda_mi_barrio

# Puerto externo para MySQL (el interno siempre es 3306)
DB_PORT_EXTERNAL=3307

# ---- Zona Horaria ----
# Zona horaria para la aplicación y la conexión MySQL
TIMEZONE=America/Havana

# ---- Next.js App ----
# Puerto para la aplicación web (docker compose usa APP_PORT)
APP_PORT=3000

# Secreto para cifrar sesiones (mínimo 32 caracteres)
# Genera uno con: openssl rand -base64 32
SESSION_SECRET=cambiar_esto_por_un_secreto_de_32_caracteres

# Cookie de sesión — secure solo detrás de HTTPS
COOKIE_SECURE=false

# ---- HTTPS local (autofirmado) ----
# Valores: true / false
HTTPS_ENABLED=false

# Dominio/origen de la app (debe coincidir con el protocolo)
APP_ORIGIN=http://localhost:3000

# TTL del caché del proxy para validar usuarios activos en BD (milisegundos).
# 0 = deshabilitar el caché. Reduce latencia si la BD es remota.
USER_ACTIVE_CACHE_TTL_MS=30000

# ---- Valkey (caché distribuida compatible con Redis) ----
# URL de conexión a Valkey. Si no está definido, la app usa caché in-memory.
#  - Docker Compose: redis://valkey:6379 (ya configurado en docker-compose.yml)
#  - Local sin Docker: redis://localhost:6380
#  - Sin caché: dejar vacío (fallback a in-memory)
VALKEY_URL=

# Puerto externo para Valkey (el interno siempre es 6379)
VALKEY_PORT_EXTERNAL=6380

# ---- Valkey (contraseña) ----
# Contraseña de Valkey, usada por docker compose (servicio valkey)
VALKEY_PASSWORD=tienda_valkey_secret
