# ============================================================
# Variables de Entorno — TiendaMiBarrio (Docker)
# ============================================================
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# ============================================================

# ---- MySQL ----
# Host del servidor MySQL:
#  - 'db' si la app corre dentro de Docker Compose (docker-compose.yml lo sobreescribe)
#  - 'localhost' si la app corre en tu máquina
DB_HOST=localhost

# Puerto MySQL al que se conecta la app:
#  - 3306 dentro de la red Docker (docker-compose.yml lo sobreescribe)
#  - 3307 si la app corre localmente contra MySQL en Docker (ver DB_PORT_EXTERNAL)
#  - 3306 si tienes MySQL instalado localmente
DB_PORT=3307

# Usuario de MySQL
DB_USER=root

# Contraseña del usuario root de MySQL
DB_PASSWORD=rootpassword

# Nombre de la base de datos
DB_NAME=tienda_mi_barrio

# Puerto externo para MySQL (el interno siempre es 3306)
DB_PORT_EXTERNAL=3307

# ---- Zona Horaria ----
# Zona horaria para la aplicación y la conexión MySQL (Havana, Cuba)
TIMEZONE=America/Havana

# ---- Next.js App ----
# Puerto para la aplicación web
APP_PORT=3000

# Secreto para cifrar sesiones (mínimo 32 caracteres)
SESSION_SECRET=cambiar_esto_por_un_secreto_de_32_caracteres
